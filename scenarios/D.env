# Scenario D: tail-based sampling in the OTel Collector.
# Usage: docker compose --env-file .env --env-file scenarios/D.env up -d
# Services record and export every trace (as in B); the collector buffers each
# trace and keeps errors, slow traces (> 500 ms) and 10% of the rest
# (collector/configs/tail.yaml).
OTEL_SDK_DISABLED=false
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0
COLLECTOR_CONFIG=tail
