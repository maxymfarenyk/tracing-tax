# Scenario E: adaptive (rate-limited) head sampling.
# Usage: docker compose --env-file .env --env-file scenarios/E.env up -d
# The gateway keeps each new trace with probability min(1, cap / rate), the
# rate measured over 5 s windows (services/adaptive_sampler); downstream
# services follow the parent's decision (ParentBased).
# Cap = 15 traces/s: the low load (10 RPS) stays below it, so every trace is
# kept; the high load (30 RPS) is above it, so ~50% (~15 traces/s) are kept.
OTEL_SDK_DISABLED=false
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=adaptive
OTEL_TRACES_SAMPLER_ARG=15
COLLECTOR_CONFIG=passthrough
