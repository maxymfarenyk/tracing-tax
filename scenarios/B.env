# Scenario B: head-based sampling, 100% (AlwaysOn).
# Usage: docker compose --env-file .env --env-file scenarios/B.env up -d
# Every trace is recorded and exported; the collector forwards all spans.
OTEL_SDK_DISABLED=false
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0
COLLECTOR_CONFIG=passthrough
