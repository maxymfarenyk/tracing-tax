# Fault injection shared by every experiment scenario (identical in all runs),
# so that each strategy can be judged on how many "interesting" traces it keeps.
# Usage: docker compose --env-file .env --env-file scenarios/faults.env \
#            --env-file scenarios/B.env up -d
# Not a scenario itself: scripts/run_experiment.py only picks up [A-Z].env.
#
# 5% of requests fail in payments (500 -> 502 up the chain, root span ERROR);
# 5% are delayed by SLOW_DELAY_MS (default 500 ms) in payments, independently.
PAYMENTS_ERROR_RATE=0.05
PAYMENTS_SLOW_RATE=0.05
