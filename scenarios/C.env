# Scenario C: head-based sampling, 10% (ParentBased + TraceIdRatio).
# Usage: docker compose --env-file .env --env-file scenarios/C.env up -d
# The gateway (root) keeps ~10% of traces by trace ID; downstream services
# follow the parent's decision, so a trace is kept or dropped as a whole.
OTEL_SDK_DISABLED=false
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
COLLECTOR_CONFIG=passthrough
