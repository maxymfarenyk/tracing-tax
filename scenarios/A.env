# Scenario A: no tracing (baseline).
# Usage: docker compose --env-file .env --env-file scenarios/A.env up -d
# The SDK is disabled, no library is instrumented and nothing is exported.
# The collector still runs, so its idle cost is the same in every scenario.
OTEL_SDK_DISABLED=true
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=*
OTEL_TRACES_EXPORTER=none
OTEL_TRACES_SAMPLER=always_off
OTEL_TRACES_SAMPLER_ARG=1.0
COLLECTOR_CONFIG=passthrough
