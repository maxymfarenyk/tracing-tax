          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Spans refused or failed (range)",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Should stay 0. Anything else means spans were lost in the pipeline.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(increase(otelcol_receiver_refused_spans{job=\"otel-collector\"}[$__range])) or vector(0)) + (sum(increase(otelcol_receiver_failed_spans{job=\"otel-collector\"}[$__range])) or vector(0)) + (sum(increase(otelcol_exporter_send_failed_spans{job=\"otel-collector\"}[$__range])) or vector(0)) + (sum(increase(otelcol_exporter_enqueue_failed_spans{job=\"otel-collector\"}[$__range])) or vector(0))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
