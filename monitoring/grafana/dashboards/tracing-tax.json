      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Batches waiting to be sent to Jaeger. Growing = the collector can't keep up.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 18
