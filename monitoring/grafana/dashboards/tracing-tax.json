      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans{job=\"otel-collector\"}[1m]))",
          "instant": true
        }
      ]
    },
